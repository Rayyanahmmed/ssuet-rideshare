# ============================================================
# SSUET RideShare :: Mobile (Expo) environment
# Copy to .env. Only EXPO_PUBLIC_* values are exposed to the app bundle,
# so never put a server-side secret here.
# ============================================================

# Use your machine's LAN IP when testing on a physical Android device:
#   http://192.168.1.25:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Maps: no key here. The provider and its key are set in Admin → Map API (server-side).

# Testing builds only: 1 = the sign-in / sign-up screens show a "Server (testing build)"
# field that changes the API URL at runtime (stored in the keystore, survives restarts),
# so a QA APK can be re-pointed at a laptop on the LAN without a rebuild. Also turns on the
# Android cleartext allowance that plain http:// needs. Leave empty for production.
EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE=

# EAS project id. Not needed for normal builds — app.config.ts already defaults to the
# project created for this repo. Set it only if you fork the app to another Expo account.
EAS_PROJECT_ID=
