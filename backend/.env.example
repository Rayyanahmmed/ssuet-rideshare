# ==========================================================
# SSUET RideShare :: Backend environment (copy to .env)
# NEVER commit the real .env file.
# ==========================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database -------------------------------------------------
# Default: SQLite, i.e. a single file next to this config. Nothing to install, no
# server to start, tables created automatically — this is the fastest way to run the
# project on a laptop (documentation/23-run-it-yourself.md).
DATABASE_URL=sqlite+pysqlite:///./ssuet_dev.db
# Production / docker-compose (PostgreSQL). Uncomment this and comment SQLite out when
# you want parity with the deployed stack — then run `alembic upgrade head` first.
# DATABASE_URL=postgresql+psycopg://ssuet:ssuet@localhost:5432/ssuet_rideshare
DB_ECHO=false

# --- JWT / sessions -------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Admin bootstrap (§17) ------------------------------------
# Created once at startup when ADMIN_BOOTSTRAP_ENABLED=true and no
# admin with this email exists. The password is NEVER reset on restart.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_BOOTSTRAP_ENABLED=true

# --- Email delivery (verification links / password reset) -----
# Leave SMTP_HOST empty to use the development console backend (emails are
# logged, not sent). Configure real SMTP before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=SSUET RideShare <no-reply@ssuet-rideshare.local>
APP_DEEP_LINK_BASE=ssuetrideshare://
ADMIN_WEB_URL=http://localhost:5173

# --- University verification ----------------------------------
# Comma separated list of accepted university domains (optional).
UNIVERSITY_EMAIL_DOMAINS=ssuet.edu.pk
# When true, a signup with a university domain is auto-verified;
# all other accounts go to manual admin verification.
AUTO_VERIFY_UNIVERSITY_EMAILS=true

# --- Maps (§13) -----------------------------------------------
# The map provider and its key are managed in the admin console (Map API tab) and
# stored encrypted in the database, so rotating a key never needs a rebuild.
# These two lines only seed a fresh install / act as a fallback.
MAP_PROVIDER=osm                  # osm (no key) | geoapify | maptiler
GEOAPIFY_API_KEY=
SSUET_LATITUDE=24.9372
SSUET_LONGITUDE=67.1138

# --- CORS / rate limiting -------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
RATE_LIMIT_ENABLED=true

# --- Notifications --------------------------------------------
# Sends to Expo's push API. Without an Expo project id in the app, notifications are
# still stored and shown in the in-app bell — only the system banner is missing.
EXPO_PUSH_ENABLED=true
# Only needed if the Expo project has "Enhanced push security" enabled (Expo → Project
# → Settings → Access tokens). Empty = send unauthenticated.
EXPO_ACCESS_TOKEN=

# --- Trip lifecycle & housekeeping (§10) ----------------------
# Minutes after departure before an unclaimed ride is marked EXPIRED.
RIDE_AUTO_EXPIRE_GRACE_MINUTES=60
# In-process housekeeping cadence in minutes (0 = disabled). In a multi-worker
# deployment leave this at 0 and run `python -m scripts.expire_stale_rides`
# from cron so API processes stay stateless.
MAINTENANCE_INTERVAL_MINUTES=15

# --- Trust policy (§7) -------------------------------------------------------
# false (default): a vehicle that is still PENDING may publish its first rides —
#                   rejected vehicles are always blocked.
# true           : only VERIFIED vehicles may publish (stricter, slower onboarding).
REQUIRE_VERIFIED_VEHICLE_FOR_PUBLISH=false

# ---------- uploaded media (Phase 9) ----------
# Verification documents are written here and served through GET /api/v1/media/{id}
# (owner or admin only). In production point this at a mounted volume and back it up
# together with the database.
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=5242880
# Uploads that no verification or vehicle references are deleted by the housekeeping
# sweep once they are this old (a member may abandon the form mid-flow).
MEDIA_ORPHAN_RETENTION_DAYS=7
