# ============================================================
# SSUET RideShare :: Admin dashboard (Vite)
# Copy to .env. Only VITE_* vars reach the browser bundle — never put
# admin credentials or server secrets here (§17, §20).
# ============================================================

# Leave empty to use the Vite dev proxy (/api → http://127.0.0.1:8000).
VITE_API_BASE_URL=

# Optional: override the proxy target used by `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8000
