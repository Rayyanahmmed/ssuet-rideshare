# Production configuration for the SSUET RideShare API.
#
# Copy to /etc/ssuet-rideshare/api.env on the server, fill every value, then:
#   chown root:ssuet /etc/ssuet-rideshare/api.env && chmod 640 /etc/ssuet-rideshare/api.env
#
# Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the filled-in file: `.env*` is gitignored deliberately.
# Quote any value containing spaces: deploy/backup.sh and deploy/restore.sh parse this
# file (they never execute it), and quoting also keeps it safe to `source` by hand.

# ---------- application ----------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- database ----------
# PostgreSQL is not optional in production: SQLite serialises writers and cannot back
# several gunicorn workers safely.
DATABASE_URL=postgresql+psycopg://ssuet:CHANGE_ME_DB_PASSWORD@localhost:5432/ssuet_rideshare
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- secrets (>= 32 characters each in production) ----------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_VALUE
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- administrator bootstrap (first boot only, then set to false) ----------
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_NAME="SSUET RideShare Administrator"
ADMIN_EMAIL=transport@ssuet.edu.pk
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- origins ----------
# The console is served from the same host, so the browser only needs one origin.
CORS_ORIGINS=https://rideshare.ssuet.edu.pk
ADMIN_WEB_URL=https://rideshare.ssuet.edu.pk
APP_DEEP_LINK_BASE=ssuetrideshare://

# ---------- email (SMTP) ----------
SMTP_HOST=smtp.ssuet.edu.pk
SMTP_PORT=587
SMTP_USER=rideshare@ssuet.edu.pk
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
EMAIL_FROM="SSUET RideShare <rideshare@ssuet.edu.pk>"
EMAIL_VERIFICATION_TOKEN_MINUTES=1440

# ---------- uploaded documents ----------
# Must be a real directory, owned by the service user, and included in backups.
MEDIA_ROOT=/var/lib/ssuet-rideshare/media
MAX_UPLOAD_BYTES=5242880
MEDIA_ORPHAN_RETENTION_DAYS=7

# ---------- rate limiting & housekeeping ----------
RATE_LIMIT_ENABLED=true
# Keep the in-process scheduler off in production: run the cron entries from
# deploy/README.md instead, so every API worker stays stateless.
MAINTENANCE_INTERVAL_MINUTES=0
RIDE_AUTO_EXPIRE_GRACE_MINUTES=60

# ---------- optional integrations (leave empty to degrade gracefully) ----------
EXPO_PUSH_ENABLED=true
# Expo project access token — only for projects with enhanced push security on.
EXPO_ACCESS_TOKEN=
