// ============================================================================
// SSUET RideShare — Prisma schema
// ============================================================================
// REFERENCE / DESIGN ARTIFACT ONLY (§2, §18).
//
// Prisma Client is NOT part of the Python runtime. The live schema is owned by
// SQLAlchemy models (backend/app/models) and Alembic migrations
// (backend/alembic). This file exists so the data model can be reviewed,
// visualized (`npx prisma studio`, `npx prisma migrate diff`) and kept in sync
// with the Python models. When a SQLAlchemy model changes, update this file in
// the same pull request — never generate Prisma migrations against the same
// database as Alembic.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Not installed by this project; keep the artifact honest.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- enums -------------------------------------

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationType {
  UNIVERSITY_EMAIL
  STUDENT_ID
  EMPLOYEE_ID
  MANUAL
}

enum VehicleType {
  CAR
  BIKE
}

enum VehicleStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RideDirection {
  HOME_TO_UNIVERSITY
  UNIVERSITY_TO_HOME
}

enum FuelPreference {
  FREE
  SHARE_FUEL
}

enum ContributionType {
  NONE
  FIXED
  EXPECTED
  NEGOTIABLE
}

enum RideStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TripStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  RIDE_REQUEST_RECEIVED
  RIDE_REQUEST_ACCEPTED
  RIDE_REQUEST_REJECTED
  RIDE_CANCELLED
  TRIP_CANCELLED
  NEW_MESSAGE
  TRIP_REMINDER
  TRIP_COMPLETED
  ACCOUNT_VERIFIED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  VEHICLE_VERIFIED
  VEHICLE_REJECTED
  NEW_REVIEW
  SYSTEM
}

enum ReportCategory {
  INAPPROPRIATE_BEHAVIOR
  FAKE_PROFILE
  MISLEADING_RIDE
  HARASSMENT
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AdminActionType {
  VERIFY_USER
  REJECT_USER_VERIFICATION
  SUSPEND_USER
  REACTIVATE_USER
  VERIFY_VEHICLE
  REJECT_VEHICLE
  UPDATE_REPORT
  CANCEL_RIDE
  OTHER
}

// ------------------------------- models ------------------------------------

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  email               String             @unique @db.VarChar(180)
  passwordHash        String             @map("password_hash") @db.VarChar(255)
  phone               String             @unique @db.VarChar(20)
  fullName            String             @map("full_name") @db.VarChar(120)
  profilePhotoUrl     String?            @map("profile_photo_url") @db.VarChar(500)
  role                UserRole           @default(STUDENT)
  department          String             @db.VarChar(120)
  universityId        String             @map("university_id") @db.VarChar(40)
  isUniversityEmail   Boolean            @default(false) @map("is_university_email")
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")
  accountStatus       AccountStatus      @default(ACTIVE) @map("account_status")
  suspensionReason    String?            @map("suspension_reason")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  verifiedAt          DateTime?          @map("verified_at")
  ratingAverage       Float              @default(0) @map("rating_average")
  ratingCount         Int                @default(0) @map("rating_count")
  completedTripsCount Int                @default(0) @map("completed_trips_count")
  lastLoginAt         DateTime?          @map("last_login_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  vehicles            Vehicle[]          @relation("VehicleOwner")
  rides               Ride[]
  rideRequests        RideRequest[]
  tripsAsDriver       Trip[]             @relation("TripDriver")
  tripsAsPassenger    Trip[]             @relation("TripPassenger")
  cancelledTrips      Trip[]             @relation("TripCancelledBy")
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  reviewsWritten      Review[]           @relation("ReviewAuthor")
  reviewsReceived     Review[]           @relation("ReviewSubject")
  reportsFiled        Report[]           @relation("ReportReporter")
  reportsReceived     Report[]           @relation("ReportTarget")
  reportsHandled      Report[]           @relation("ReportHandler")
  verifications       Verification[]     @relation("VerificationUser")
  reviewedVehicles    Vehicle[]          @relation("VehicleReviewer")
  reviewedVerifications Verification[]   @relation("VerificationReviewer")
  adminActions        AdminAction[]      @relation("AdminActor")
  adminActionsOnMe    AdminAction[]      @relation("AdminTarget")
  blocksInitiated     UserBlock[]        @relation("Blocker")
  blocksReceived      UserBlock[]        @relation("Blocked")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  messages            Message[]

  @@unique([role, universityId])
  @@index([role, accountStatus])
  @@map("users")
}

model StudentProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  studentId       String   @map("student_id") @db.VarChar(40)
  department      String   @db.VarChar(120)
  degreeProgramme String?  @map("degree_programme") @db.VarChar(120)
  semester        Int?
  batchYear       Int?     @map("batch_year")
  homeArea        String?  @map("home_area") @db.VarChar(160)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_profiles")
}

model TeacherProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.VarChar(40)
  department  String   @db.VarChar(120)
  designation String   @db.VarChar(120)
  homeArea    String?  @map("home_area") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("teacher_profiles")
}

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @map("owner_id") @db.Uuid
  vehicleType        VehicleType   @map("vehicle_type")
  makeAndModel       String        @map("make_and_model") @db.VarChar(120)
  color              String        @db.VarChar(60)
  registrationNumber String        @map("registration_number") @db.VarChar(40)
  vehiclePhotoUrl    String?       @map("vehicle_photo_url") @db.VarChar(500)
  passengerCapacity  Int           @default(1) @map("passenger_capacity")
  isPrimary          Boolean       @default(false) @map("is_primary")
  status             VehicleStatus @default(PENDING)
  reviewedById       String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?     @map("reviewed_at")
  reviewNote         String?       @map("review_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  owner      User  @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer   User? @relation("VehicleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rides      Ride[]

  @@index([ownerId, status])
  @@index([registrationNumber])
  @@map("vehicles")
}

model Ride {
  id                    String           @id @default(uuid()) @db.Uuid
  driverId              String           @map("driver_id") @db.Uuid
  vehicleId             String?          @map("vehicle_id") @db.Uuid
  vehicleType           VehicleType      @map("vehicle_type")
  direction             RideDirection
  pickupArea            String           @map("pickup_area") @db.VarChar(160)
  pickupLatitude        Float            @map("pickup_latitude")
  pickupLongitude       Float            @map("pickup_longitude")
  destinationArea       String           @map("destination_area") @db.VarChar(160)
  destinationLatitude   Float            @map("destination_latitude")
  destinationLongitude  Float            @map("destination_longitude")
  departureDate         DateTime         @map("departure_date")
  departureAt           DateTime         @map("departure_at")
  availableSeats        Int              @default(1) @map("available_seats")
  seatsRemaining        Int              @default(1) @map("seats_remaining")
  fuelPreference        FuelPreference   @map("fuel_preference")
  contributionType      ContributionType @default(NONE) @map("contribution_type")
  contributionAmount    Decimal?         @map("contribution_amount") @db.Decimal(10, 2)
  contributionNote      String?          @map("contribution_note") @db.VarChar(200)
  note                  String?
  status                RideStatus       @default(OPEN)
  matchedAt             DateTime?        @map("matched_at")
  startedAt             DateTime?        @map("started_at")
  completedAt           DateTime?        @map("completed_at")
  cancelledAt           DateTime?        @map("cancelled_at")
  cancellationReason    String?          @map("cancellation_reason")
  isAdminCancelled      Boolean          @default(false) @map("is_admin_cancelled")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")

  driver   User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  requests RideRequest[]
  trips    Trip[]
  reports  Report[]

  @@index([status, departureDate, direction])
  @@index([driverId, status])
  @@index([departureAt])
  @@index([pickupArea])
  @@map("rides")
}

model RideRequest {
  id           String            @id @default(uuid()) @db.Uuid
  rideId       String            @map("ride_id") @db.Uuid
  passengerId  String            @map("passenger_id") @db.Uuid
  message      String?           @db.VarChar(300)
  status       RideRequestStatus @default(PENDING)
  respondedAt  DateTime?         @map("responded_at")
  responseNote String?           @map("response_note") @db.VarChar(300)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  ride      Ride  @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger User  @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  trip      Trip?

  @@index([rideId, status])
  @@index([passengerId, status])
  // Enforced in PostgreSQL as a partial unique index:
  //   CREATE UNIQUE INDEX uq_ride_requests_pending_pair
  //     ON ride_requests (ride_id, passenger_id) WHERE status = 'PENDING';
  @@map("ride_requests")
}

model Trip {
  id                        String     @id @default(uuid()) @db.Uuid
  rideId                    String     @map("ride_id") @db.Uuid
  requestId                 String     @unique @map("request_id") @db.Uuid
  driverId                  String     @map("driver_id") @db.Uuid
  passengerId               String     @map("passenger_id") @db.Uuid
  status                    TripStatus @default(CONFIRMED)
  meetingPoint              String?    @map("meeting_point") @db.VarChar(300)
  meetingLatitude           Float?     @map("meeting_latitude")
  meetingLongitude          Float?     @map("meeting_longitude")
  startedAt                 DateTime?  @map("started_at")
  completedAt               DateTime?  @map("completed_at")
  cancelledAt               DateTime?  @map("cancelled_at")
  cancelledById             String?    @map("cancelled_by_id") @db.Uuid
  cancellationReason        String?    @map("cancellation_reason")
  driverConfirmedComplete   Boolean    @default(false) @map("driver_confirmed_complete")
  passengerConfirmedComplete Boolean   @default(false) @map("passenger_confirmed_complete")
  driverReviewedPassenger   Boolean    @default(false) @map("driver_reviewed_passenger")
  passengerReviewedDriver   Boolean    @default(false) @map("passenger_reviewed_driver")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  ride         Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  request      RideRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  driver       User          @relation("TripDriver", fields: [driverId], references: [id], onDelete: Cascade)
  passenger    User          @relation("TripPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  cancelledBy  User?         @relation("TripCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  conversation Conversation?
  reviews      Review[]
  reports      Report[]

  // ONE CONFIRMED PASSENGER PER RIDE — partial unique index in PostgreSQL:
  //   CREATE UNIQUE INDEX uq_trips_one_active_per_ride
  //     ON trips (ride_id) WHERE status <> 'CANCELLED';
  @@index([driverId, status])
  @@index([passengerId, status])
  @@map("trips")
}

model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  tripId             String    @unique @map("trip_id") @db.Uuid
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(160)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(160)
  body       String
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  data       Json?
  pushSentAt DateTime?        @map("push_sent_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  platform   String    @default("android") @db.VarChar(20)
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author  User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tripId, authorId])
  @@index([subjectId, createdAt])
  @@map("reviews")
}

model Report {
  id             String         @id @default(uuid()) @db.Uuid
  reporterId     String         @map("reporter_id") @db.Uuid
  reportedUserId String         @map("reported_user_id") @db.Uuid
  rideId         String?        @map("ride_id") @db.Uuid
  tripId         String?        @map("trip_id") @db.Uuid
  category       ReportCategory
  description    String
  status         ReportStatus   @default(OPEN)
  handledById    String?        @map("handled_by_id") @db.Uuid
  resolutionNote String?        @map("resolution_note")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  reporter     User          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User          @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  handledBy    User?         @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  ride         Ride?         @relation(fields: [rideId], references: [id], onDelete: SetNull)
  trip         Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  adminActions AdminAction[]

  @@index([status, createdAt])
  @@index([reportedUserId, status])
  @@map("reports")
}

model Verification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  verificationType VerificationType   @map("verification_type")
  status           VerificationStatus @default(PENDING)
  submittedValue   String?            @map("submitted_value") @db.VarChar(180)
  documentUrl      String?            @map("document_url") @db.VarChar(500)
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewNote       String?            @map("review_note")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user     User  @relation("VerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("verifications")
}

model AdminAction {
  id           String          @id @default(uuid()) @db.Uuid
  adminId      String?         @map("admin_id") @db.Uuid
  actionType   AdminActionType @map("action_type")
  targetUserId String?         @map("target_user_id") @db.Uuid
  reportId     String?         @map("report_id") @db.Uuid
  entityType   String?         @map("entity_type") @db.VarChar(40)
  entityId     String?         @map("entity_id") @db.Uuid
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  admin      User?  @relation("AdminActor", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User?  @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  report     Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([targetUserId])
  @@map("admin_actions")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
